{
  "schema_version": "1.0",
  "id": "squad-feature",
  "phases": ["initialized", "requirements", "requirements_review", "design", "planned", "implementation", "deterministic_checks", "review", "test_authoring", "verification", "ready_to_finish", "complete", "blocked"],
  "max_cycles": 2,
  "entrypoints": ["squad-feature", "squad-plan", "squad-execute"],
  "transitions": {
    "initialized": ["requirements"],
    "requirements": ["requirements_review"],
    "requirements_review": ["requirements", "design"],
    "design": ["planned"],
    "planned": ["implementation"],
    "implementation": ["deterministic_checks"],
    "deterministic_checks": ["implementation", "review"],
    "review": ["implementation", "test_authoring", "verification"],
    "test_authoring": ["deterministic_checks"],
    "verification": ["implementation", "ready_to_finish"],
    "ready_to_finish": ["complete"],
    "complete": []
  },
  "preconditions": {
    "review": ["gates_passed"],
    "verification": ["gates_passed", "review_recorded"],
    "ready_to_finish": ["gates_passed", "review_recorded"]
  },
  "cycle_transitions": [["review", "implementation"], ["verification", "implementation"]],
  "required_gates": ["test", "scope"]
}
